{
  // Dead-code check, run by `just deadcode`. Plugins are auto-enabled from each workspace's
  // dependencies: wxt (entrypoints/**), vitest (**/*.test.*), playwright (e2e specs),
  // biome and dependency-cruiser (config files).
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      // The vendored anti-slop plugin (tools/oxlint/anti-slop/UPSTREAM.md) is not ours to prune. The
      // oxlint CLI runs from `just slop`, which knip does not read.
      "ignore": ["tools/oxlint/anti-slop/**"],
      "ignoreDependencies": ["oxlint"]
    },
    "apps/extension": {
      // wxt discovers entrypoints/** by convention and only the manifest names them; e2e/** holds
      // helpers (launch.ts, site.ts) beyond the *.spec.ts files the playwright plugin adds.
      "entry": ["entrypoints/**/*.{ts,tsx}", "e2e/**/*.ts", "test/**/*.{ts,tsx}"],
      "project": ["{entrypoints,src,test,e2e}/**/*.{ts,tsx}", "*.{ts,cjs}"],
      // DEFAULT_PRIMARY_ID = MULTI: the name says "the default choice" where MULTI says "which strategy".
      "ignoreIssues": { "src/features/ratings/model/cpu/strategy-ids.ts": ["duplicates"] }
    },
    // Each package.json `exports` entry (the public barrel src/index.ts, subpath exports, test
    // fixtures) is an entry file, so its exports are public API for a later backend/MCP consumer
    // and are never reported. Everything below a barrel must be reachable from it or from a test.
    "packages/*": {
      "entry": ["test/**/*.ts"],
      "project": ["{src,test}/**/*.ts", "*.ts"],
      // DEFAULT_ORIGIN = IDEALO_ORIGIN: public API names the url grammar's default separately from the site it targets.
      "ignoreIssues": { "src/url/constants.ts": ["duplicates"] }
    }
  }
}
